---
layout: base.njk
title: All Posts
permalink: /all-posts/
---
<div class="wrap">
  <h1 style="margin-bottom:28px;">All Posts</h1>
  {% for article in collections.articles %}
  <div style="padding:18px 0;border-bottom:1px solid var(--hairline);">
    <span class="tag-pill" style="margin-bottom:8px;">{{ article.data.tag }}</span>
    <h3 style="font-size:18px;font-weight:600;margin-bottom:6px;">
      <a href="{{ article.url }}" style="color:var(--ink);text-decoration:none;">{{ article.data.title }}</a>
    </h3>
    <p style="font-size:13.5px;color:var(--ink-dim);margin:0;">{{ article.date | readableDate }}</p>
  </div>
  {% else %}
  <p class="empty-note">No articles published yet.</p>
  {% endfor %}
</div>
