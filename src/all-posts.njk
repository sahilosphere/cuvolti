---
layout: base.njk
title: All Posts
permalink: /all-posts/
---
<div class="all-posts-wrap">
  <h1 class="all-posts-title">All Posts</h1>
  <div class="filter-bar" style="padding:0;margin:0 0 24px;">
    <label for="category-select" class="filter-label">Filter by category</label>
    <select id="category-select" class="category-select">
      <option value="All">All</option>
      <option value="Random Thoughts">Random Thoughts</option>
      <option value="Opinions">Opinions</option>
      <option value="Information">Information</option>
      <option value="Life & Observations">Life & Observations</option>
      <option value="Tech & Trends">Tech & Trends</option>
      <option value="Learnings">Learnings</option>
      <option value="Personal">Personal</option>
      <option value="Current Affairs">Current Affairs</option>
    </select>
  </div>

  <div class="article-list" style="padding:0;margin:0;">
  {% for article in collections.articles %}
    <a class="article-row filter-item fade-in-up" style="transition-delay:{{ loop.index0 * 50 }}ms" data-category="{{ article.data.category }}" href="{{ article.url }}">
      <div class="article-thumb">
        {% if article.data.image %}
          <img src="{{ article.data.image }}" alt="{{ article.data.title }}" loading="lazy">
        {% else %}
          <div class="thumb-placeholder"></div>
        {% endif %}
      </div>
      <div class="article-info">
        <h3>{{ article.data.title }}</h3>
        <p>
          {% if article.data.excerpt %}
            {{ article.data.excerpt }}
          {% else %}
            {{ article.templateContent | striptags | truncate(140, true, "...") }}
          {% endif %}
        </p>
        <span class="date">{{ article.date | readableDate }}{% if article.data.category %} · <span class="cat-badge">{{ article.data.category }}</span>{% endif %}</span>
      </div>
    </a>
  {% else %}
    <p class="empty-note">No articles published yet.</p>
  {% endfor %}
  </div>
</div>
